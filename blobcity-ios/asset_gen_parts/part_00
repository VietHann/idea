S=4

def canvas(size=256):
    im=Image.new('RGBA',(size*S,size*S),(0,0,0,0)); return im,ImageDraw.Draw(im)
def down(im): return im.resize((im.width//S,im.height//S),Image.Resampling.LANCZOS)
def rr(d,xy,r,fill,outline=None,w=1):
    d.rounded_rectangle(tuple(int(v*S) for v in xy),radius=r*S,fill=fill,outline=outline,width=w*S)
def el(d,xy,fill,outline=None,w=1):
    d.ellipse(tuple(int(v*S) for v in xy),fill=fill,outline=outline,width=w*S)
def poly(d,pts,fill): d.polygon([(int(x*S),int(y*S)) for x,y in pts],fill=fill)
def line(d,pts,fill,w=1): d.line([(int(x*S),int(y*S)) for x,y in pts],fill=fill,width=w*S,joint='curve')
def save(im,name): down(im).save(SPR/name,optimize=True)

