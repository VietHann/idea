            }
        case .absoluteCinema:
            chaos = 46
            run(.playSoundFileNamed("power.wav", waitForCompletion: false))
            Haptics.heavy()
            cameraNode.run(.sequence([
                .scale(to: cameraNode.xScale * 0.88, duration: 0.18),
                .wait(forDuration: 0.8),
                .scale(to: cameraNode.xScale, duration: 0.25)
            ]))
            confetti()
        }
    }

    private func spawnTaxVan() {
        guard taxVan == nil else { return }
        let van = SKSpriteNode(imageNamed: "taxvan")
        van.size = CGSize(width: 116, height: 116)
        let angle = CGFloat.random(in: 0...(2 * .pi))
        van.position = CGPoint(x: player.position.x + cos(angle)*650, y: player.position.y + sin(angle)*650)
        van.zPosition = 35
        van.name = "taxVan"
        world.addChild(van)
        taxVan = van
        let siren = SKAction.sequence([.colorize(with: .red, colorBlendFactor: 0.35, duration: 0.16), .colorize(withColorBlendFactor: 0, duration: 0.16)])
        van.run(.repeatForever(siren))
    }

