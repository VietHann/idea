    @discardableResult
    private func spawn(_ spec: EntitySpec, at position: CGPoint) -> SKSpriteNode {
        let n = SKSpriteNode(imageNamed: spec.texture)
        n.size = CGSize(width: spec.baseSize, height: spec.baseSize)
        n.position = position
        n.zPosition = spec.isNPC ? 15 : 10
        n.userData = [
            "mass": NSNumber(value: Double(spec.mass)),
            "points": NSNumber(value: spec.points),
            "display": spec.display,
            "isNPC": NSNumber(value: spec.isNPC),
            "mutation": spec.mutation?.rawValue ?? ""
        ]
        n.name = spec.isNPC ? "npc" : "edible"
        world.addChild(n)
        entities.append(n)
        if spec.isNPC {
            npcNodes.append(n)
            let bob = SKAction.sequence([.moveBy(x: 0, y: 5, duration: 0.28), .moveBy(x: 0, y: -5, duration: 0.28)])
            n.run(.repeatForever(bob))
        }
        return n
    }

    private func addLockedBadge(to node: SKSpriteNode) {
        let badge = SKLabelNode(fontNamed: "AvenirNext-Heavy")
        badge.text = "🔒 MASS 55"
        badge.fontSize = 14
        badge.fontColor = .white
        badge.position = CGPoint(x: 0, y: node.size.height * 0.58)
        badge.name = "lockBadge"
        node.addChild(badge)
    }

    private func randomPoint(margin: CGFloat) -> CGPoint {
        CGPoint(x: CGFloat.random(in: (-worldSize.width/2 + margin)...(worldSize.width/2 - margin)),
                y: CGFloat.random(in: (-worldSize.height/2 + margin)...(worldSize.height/2 - margin)))
    }

    override func update(_ currentTime: TimeInterval) {
        guard !gameEnded else { return }
        let dt = lastUpdate == 0 ? 1.0/60.0 : min(1.0/20.0, currentTime - lastUpdate)
        lastUpdate = currentTime
        elapsed += dt
        comboTimer -= dt
        if comboTimer <= 0 { combo = 0 }
        eventTimer -= dt
